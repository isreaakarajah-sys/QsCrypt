<?xml version="1.0" encoding="utf-8"?>
<!--
  QsCrypt never requests android.permission.INTERNET: the OS itself then blocks
  every network socket, so the app cannot leak data even by mistake.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only to know whether a network is up, for the "offline only" policy. Not INTERNET. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- USB flash drives and disks through OTG; the app still installs without USB host. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- Long copies and encryptions keep running with a progress notification (not in disguise mode). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      «ملفاتي»: the phone's own files, like a file manager. Android 11+ asks for
      "all files access" (MANAGE_EXTERNAL_STORAGE) in Settings; earlier versions
      use the storage permission. Nothing leaves the phone: there is no INTERNET.
    -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".QsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QsCrypt">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Two launcher entries for the same activity. Disguise mode (Settings)
          disables the first and enables the second: the app then appears as a
          working calculator, and the PIN followed by "=" opens it.
        -->
        <activity-alias
            android:name=".Launcher"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Calculator"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_calc"
            android:label="@string/calc_name"
            android:roundIcon="@mipmap/ic_calc_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
          "Share" from other apps: files go into an open vault or are encrypted
          as QsCrypt files. Disabled in disguise mode (it would name the app).
        -->
        <activity-alias
            android:name=".ShareTarget"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>

        <!-- Background operations: copies, imports, exports, encryption, filling free space. -->
        <service
            android:name=".JobService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".LockAllReceiver"
            android:exported="false" />

        <!-- Quick settings tile: lock every vault. Disabled in disguise mode. -->
        <service
            android:name=".LockTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_lock"
            android:label="@string/tile_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Hands this APK to the share sheet, and receives QR photos from the camera app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
